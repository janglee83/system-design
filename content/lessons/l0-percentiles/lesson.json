{
  "formatVersion": 1,
  "id": "l0-percentiles",
  "level": "L0",
  "kind": "experiment",
  "minutes": 15,
  "difficulty": 2,
  "prerequisites": ["l0-queueing-and-utilization"],
  "concepts": ["percentile", "tail-latency", "sli-slo"],
  "research": ["percentiles-and-tail-latency"],
  "status": "draft",
  "experiment": {
    "base": {
      "graph": {
        "nodes": [
          {
            "id": "users",
            "kind": "client"
          },
          {
            "id": "web",
            "kind": "web-server",
            "config": {
              "cpu": 1,
              "memoryGb": 2
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "from": "users",
            "to": "web",
            "kind": "http"
          }
        ]
      },
      "workload": {
        "profile": "mixed",
        "baseRps": 6000,
        "writeRatio": 0.2,
        "surge": {
          "factor": 2,
          "atMs": 4000,
          "durationMs": 400
        }
      }
    },
    "controls": [
      {
        "id": "cpu",
        "type": "stepper",
        "path": "graph.nodes[web].config.cpu",
        "options": [1, 2],
        "default": 1
      },
      {
        "id": "memoryGb",
        "type": "stepper",
        "path": "graph.nodes[web].config.memoryGb",
        "options": [2, 8],
        "default": 2
      }
    ],
    "goals": [
      {
        "id": "typical",
        "metric": "p50",
        "op": "<=",
        "value": 10
      },
      {
        "id": "unlucky",
        "metric": "p99",
        "op": "<=",
        "value": 50
      }
    ],
    "choices": [
      {
        "id": "A",
        "correct": true,
        "set": {
          "cpu": 2,
          "memoryGb": 2
        },
        "expect": {
          "p50": {
            "<=": 10
          },
          "p99": {
            "<=": 15
          }
        }
      },
      {
        "id": "B",
        "misconception": "M1",
        "set": {
          "cpu": 1,
          "memoryGb": 2
        },
        "failsGoals": ["unlucky"],
        "expect": {
          "p50": {
            "<=": 10
          },
          "p95": {
            ">=": 40
          },
          "p99": {
            ">=": 80
          }
        }
      },
      {
        "id": "C",
        "misconception": "M3",
        "set": {
          "cpu": 1,
          "memoryGb": 8
        },
        "failsGoals": ["unlucky"],
        "expect": {
          "p50": {
            "<=": 10
          },
          "p99": {
            ">=": 80
          },
          "requestsRejected": {
            "==": 0
          }
        }
      }
    ]
  }
}
