{
  "formatVersion": 1,
  "id": "l0-throughput-and-capacity",
  "level": "L0",
  "kind": "experiment",
  "minutes": 15,
  "difficulty": 1,
  "prerequisites": ["l0-client-server"],
  "concepts": ["throughput", "capacity", "overload", "rps"],
  "research": ["throughput-and-capacity"],
  "status": "draft",
  "experiment": {
    "base": {
      "graph": {
        "nodes": [
          {
            "id": "users",
            "kind": "client"
          },
          {
            "id": "web",
            "kind": "web-server",
            "config": {
              "cpu": 1,
              "memoryGb": 2
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "from": "users",
            "to": "web",
            "kind": "http"
          }
        ]
      },
      "workload": {
        "profile": "mixed",
        "baseRps": 12000,
        "writeRatio": 0.2
      }
    },
    "controls": [
      {
        "id": "cpu",
        "type": "stepper",
        "path": "graph.nodes[web].config.cpu",
        "options": [1, 2, 4],
        "default": 1
      },
      {
        "id": "memoryGb",
        "type": "stepper",
        "path": "graph.nodes[web].config.memoryGb",
        "options": [2, 8],
        "default": 2
      },
      {
        "id": "timeout",
        "type": "select",
        "path": "workload.clientTimeoutMs",
        "options": [1000, 5000],
        "default": 1000
      }
    ],
    "goals": [
      {
        "id": "fast",
        "metric": "p95",
        "op": "<=",
        "value": 50
      },
      {
        "id": "no-drops",
        "metric": "requestsRejected",
        "op": "<=",
        "value": 0
      }
    ],
    "choices": [
      {
        "id": "A",
        "correct": true,
        "set": {
          "cpu": 2,
          "memoryGb": 2,
          "timeout": 1000
        },
        "expect": {
          "p95": {
            "<=": 10
          },
          "requestsRejected": {
            "==": 0
          },
          "peakBusy": {
            ">=": 0.8,
            "<=": 0.95
          }
        }
      },
      {
        "id": "B",
        "misconception": "M1",
        "set": {
          "cpu": 1,
          "memoryGb": 8,
          "timeout": 1000
        },
        "failsGoals": ["fast"],
        "expect": {
          "p95": {
            ">=": 1000
          },
          "requestsTimedOut": {
            ">=": 1
          },
          "requestsRejected": {
            "==": 0
          }
        }
      },
      {
        "id": "C",
        "misconception": "M2",
        "set": {
          "cpu": 1,
          "memoryGb": 2,
          "timeout": 5000
        },
        "failsGoals": ["fast", "no-drops"],
        "expect": {
          "p95": {
            ">=": 500
          },
          "requestsRejected": {
            ">=": 1
          }
        },
        "expectEvents": ["node.overloaded"]
      },
      {
        "id": "D",
        "misconception": "M3",
        "set": {
          "cpu": 1,
          "memoryGb": 2,
          "timeout": 1000
        },
        "failsGoals": ["fast", "no-drops"],
        "expect": {
          "p95": {
            ">=": 500
          },
          "requestsRejected": {
            ">=": 1
          }
        },
        "expectEvents": ["node.overloaded"]
      }
    ]
  }
}
