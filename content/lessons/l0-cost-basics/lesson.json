{
  "formatVersion": 1,
  "id": "l0-cost-basics",
  "level": "L0",
  "kind": "experiment",
  "minutes": 12,
  "difficulty": 1,
  "prerequisites": ["l0-throughput-and-capacity"],
  "concepts": ["cost-per-month", "right-sizing", "over-provisioning"],
  "research": ["cost-basics", "throughput-and-capacity"],
  "status": "draft",
  "experiment": {
    "base": {
      "graph": {
        "nodes": [
          {
            "id": "users",
            "kind": "client"
          },
          {
            "id": "web",
            "kind": "web-server",
            "config": {
              "cpu": 8
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "from": "users",
            "to": "web",
            "kind": "http"
          }
        ]
      },
      "workload": {
        "profile": "mixed",
        "baseRps": 10000,
        "writeRatio": 0.2
      }
    },
    "controls": [
      {
        "id": "cpu",
        "type": "stepper",
        "path": "graph.nodes[web].config.cpu",
        "options": [1, 2, 3, 8],
        "default": 8
      }
    ],
    "goals": [
      {
        "id": "fast",
        "metric": "p95",
        "op": "<=",
        "value": 20
      },
      {
        "id": "no-drops",
        "metric": "requestsRejected",
        "op": "<=",
        "value": 0
      },
      {
        "id": "budget",
        "metric": "costPerMonth",
        "op": "<=",
        "value": 50
      }
    ],
    "choices": [
      {
        "id": "A",
        "correct": true,
        "set": {
          "cpu": 2
        },
        "expect": {
          "p95": {
            "<=": 10
          },
          "requestsRejected": {
            "==": 0
          },
          "costPerMonth": {
            "==": 50
          }
        }
      },
      {
        "id": "B",
        "misconception": "M1",
        "set": {
          "cpu": 8
        },
        "failsGoals": ["budget"],
        "expect": {
          "p95": {
            "<=": 10
          },
          "costPerMonth": {
            "==": 215
          },
          "peakBusy": {
            "<=": 0.3
          }
        }
      },
      {
        "id": "C",
        "misconception": "M2",
        "set": {
          "cpu": 1
        },
        "failsGoals": ["fast", "no-drops"],
        "expect": {
          "p95": {
            ">=": 300
          },
          "requestsRejected": {
            ">=": 1
          },
          "costPerMonth": {
            "==": 22.5
          }
        },
        "expectEvents": ["node.overloaded"]
      },
      {
        "id": "D",
        "misconception": "M3",
        "set": {
          "cpu": 3
        },
        "failsGoals": ["budget"],
        "expect": {
          "p95": {
            "<=": 10
          },
          "costPerMonth": {
            "==": 77.5
          }
        }
      }
    ]
  }
}
